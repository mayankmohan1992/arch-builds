# Built from source (not the released AppImage) so the bundled native helpers -
# native/resource-monitor is Rust - are compiled for this CPU via RUSTFLAGS.
#
# Packaging layout (install prefix, wrapper, desktop entry) mirrors the upstream
# AUR t3code-bin recipe so switching between them is clean.
pkgname=t3code
pkgver=0.1.6
pkgrel=1
pkgdesc='Desktop control surface for local coding agents'
arch=('x86_64')
url='https://github.com/pingdotgg/t3code'
license=('MIT')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libdrm'
  'libgcc'
  'libstdc++'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
  'zlib'
)
optdepends=('openai-codex: use the system-installed Codex CLI')
provides=("t3code=$pkgver")
conflicts=('t3code-bin' 't3code-nightly-bin')
makedepends=('nodejs' 'pnpm' 'rust' 'git' 'imagemagick')
options=('!debug' '!strip')
# The tarball is pinned by tag over TLS rather than hashed: the version is
# bumped by CI from the upstream release tag, so a static checksum cannot be
# maintained. Arch-style reproducibility is traded for automatic tracking.
source=("$pkgname-$pkgver.tar.gz::https://github.com/pingdotgg/t3code/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"

  # The repo pins engines.node to one exact patch release; the distro node may
  # be a patch newer, which must not abort the build.
  export npm_config_engine_strict=false
  export COREPACK_ENABLE_STRICT=0

  pnpm install --frozen-lockfile
  # Compile the Rust resource-monitor helper (and any other native pieces the
  # desktop artifact script needs) before packaging.
  pnpm build:resource-monitor

  # Only the AppImage is needed for an Arch package. electron-builder is asked
  # for AppImage *and* deb; its bundled fpm needs a portable Ruby runtime that
  # fails to start here (exit 127), which aborts the whole build. Drop the deb
  # target. The guard makes an upstream refactor fail loudly instead of silently
  # building the wrong set.
  if grep -q '\[target, "deb"\]' scripts/build-desktop-artifact.ts; then
    sed -i 's/\[target, "deb"\]/[target]/' scripts/build-desktop-artifact.ts
  fi
  if grep -q '\[target, "deb"\]' scripts/build-desktop-artifact.ts; then
    echo "could not drop the deb target; upstream changed" >&2
    return 1
  fi

  # Upstream tags the release (v0.1.6) but the workspace package.json files
  # still say 0.1.5 at that commit, so the artifact script would stamp the wrong
  # version into the app and the AppImage name. Pass the tag version explicitly.
  T3CODE_DESKTOP_VERSION="$pkgver" pnpm dist:desktop:linux
}

package() {
  cd "$pkgname-$pkgver"

  local appimage
  appimage=$(find release -maxdepth 1 -name '*.AppImage' -print -quit)
  [[ -n $appimage ]] || { echo "no AppImage produced" >&2; return 1; }

  chmod +x "$appimage"
  rm -rf squashfs-root
  "$appimage" --appimage-extract >/dev/null

  install -d "$pkgdir/opt/$pkgname"
  cp -a --no-preserve=ownership squashfs-root/. "$pkgdir/opt/$pkgname/"
  chmod -R u=rwX,go=rX "$pkgdir/opt/$pkgname"
  chmod 4755 "$pkgdir/opt/$pkgname/chrome-sandbox"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/t3code" <<'EOF'
#!/bin/sh
exec /opt/t3code/AppRun "$@"
EOF
  ln -s t3code "$pkgdir/usr/bin/t3-code-desktop"

  local icon size_dir
  for icon in squashfs-root/usr/share/icons/hicolor/*/apps/t3code.png; do
    [[ -e $icon ]] || continue
    size_dir="${icon%/apps/t3code.png}"
    install -Dm644 "$icon" \
      "$pkgdir/usr/share/icons/hicolor/${size_dir##*/}/apps/t3code.png"
  done

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/t3code.desktop" <<'EOF'
[Desktop Entry]
Name=T3 Code
Comment=Desktop control surface for local coding agents
Exec=t3code %U
TryExec=t3code
Terminal=false
Type=Application
Icon=t3code
StartupWMClass=t3code
Categories=Development;
MimeType=x-scheme-handler/t3code;
EOF

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
